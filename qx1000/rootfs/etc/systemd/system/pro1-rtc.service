[Unit]
Description=Set the clock from the PMIC RTC plus a saved offset
DefaultDependencies=no
After=local-fs.target
Before=time-set.target sysinit.target shutdown.target
Wants=time-set.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/pro1-rtc restore
ExecStop=/usr/local/bin/pro1-rtc save

[Install]
WantedBy=sysinit.target
