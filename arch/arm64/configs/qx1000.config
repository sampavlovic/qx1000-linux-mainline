# Fxtec Pro1 (MSM8998) on top of arm64 defconfig. Non-Qualcomm ARCH_* are
# switched off by scripts/qx1000-build.sh. Root path (UFS -> btrfs) is built in, so
# no initramfs is needed.
CONFIG_LOCALVERSION="-pro1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEBUG_INFO_NONE=y

# EFI boot through systemd-boot on boot_a
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=y

# Root path: UFS -> btrfs, all built in
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_MSM_GCC_8998=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_PINCTRL_MSM8998=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y

# Display: UEFI framebuffer first (simpledrm), then msm DRM + panel take over
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_MSM_MMCC_8998=m
CONFIG_MSM_GPUCC_8998=m
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_PANEL_BOE_BF060Y8M_AJ0=m
# CONFIG_DRM_NOUVEAU is not set

# Input: keyboard (AW9523 + fastmatrix), touch, buttons, hall sensor
CONFIG_PINCTRL_AW9523=y
CONFIG_KEYBOARD_GPIO_FASTMATRIX=y
CONFIG_KEYBOARD_GPIO=m
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_INPUT_UINPUT=m
CONFIG_LEDS_GPIO=m

# USB peripheral + g_ether for ssh over USB
CONFIG_EXTCON_USB_GPIO=m
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_QCOM=m
CONFIG_PHY_QCOM_QUSB2=m
CONFIG_PHY_QCOM_QMP_USB=m
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=m
# CONFIG_USB_ETH_RNDIS is not set

# Remote processors, WiFi, BT
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y

# Fedora / systemd expectations
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_AUDIT=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_PSI=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m

# Crash logs survive a warm reboot (ramoops region is in the Pro1 DT)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Readable console on a 1080x2160 panel (fbcon picks the big font itself)
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# PMIC RTC built in so pro1-rtc.service finds it early (offset kept in userspace)
CONFIG_RTC_DRV_PM8XXX=y

# PMI8998 fuel gauge, out-of-tree driver from msm8998-mainline
CONFIG_BATTERY_QCOM_FG=m

# ModemManager: QMI control port of the modem over rpmsg (DATA5_CNTL)
CONFIG_RPMSG_WWAN_CTRL=m


# Fedora dist-alsa.conf loads snd-seq after every snd-pcm; without it udev
# could not autoload any ALSA driver (the sound card never appeared)
CONFIG_SND_SEQUENCER=m

# CPU frequency scaling: CPRh voltage control for the OSM (patches 0031-0046)
CONFIG_QCOM_CPR3=y
CONFIG_ARM_QCOM_CPUFREQ_HW=m
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Omarchy/Arch userspace: ufw on iptables-nft (without NFT_COMPAT no xt match loads, a
# half-loaded ruleset left INPUT on DROP and cut off SSH), docker NAT, sysctl defaults
CONFIG_NFT_COMPAT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_NAT=m
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_HL=m
CONFIG_IP6_NF_MATCH_IPV6HEADER=m
CONFIG_IP6_NF_MATCH_FRAG=m

# watchdog built in so it is armed before userspace
CONFIG_QCOM_WDT=y

# PMI8998 SMB2 charger
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_QCOM_SPMI_RRADC=m


# PMI8998 vibrator (patch 0048)
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m
CONFIG_INPUT_FF_MEMLESS=m


# SSC sensors (SLPI Sensor Manager over QRTR; registry from qcom/sensors/sns.reg)
CONFIG_IIO_QCOM_SMGR=m
CONFIG_QCOM_SNS_REG=m
